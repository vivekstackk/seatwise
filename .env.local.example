# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Neon connection string. Get this from your Neon project dashboard
# -> Connection Details -> "Pooled connection" string. Used by the
# running app (src/lib/db/index.ts).
# Example shape: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# The DIRECT (unpooled) Neon connection string — same dashboard, but
# toggle OFF "Connection pooling" before copying. Hostname will NOT
# have "-pooler" in it. Used ONLY by drizzle-kit when running
# migrations (npx drizzle-kit migrate) — Neon's pooled connections
# don't reliably support the session behavior migrations need, and
# using the pooled URL here causes `migrate` to hang indefinitely.
DIRECT_DATABASE_URL=

# Random 32+ character string used by Better Auth to sign session
# tokens. Generate one with:
#   PowerShell:  -join ((48..57)+(97..122)|Get-Random -Count 40|%{[char]$_})
BETTER_AUTH_SECRET=

# Base URL Better Auth uses to build callback/redirect links. Also used
# to build Stripe's success_url/cancel_url (src/lib/db/seats.ts), so it
# must be the real origin in production, not localhost.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client, from Google Cloud Console -> APIs & Services ->
# Credentials -> Create OAuth client ID -> Web application.
# Authorized redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google
# (and the deployed equivalent). Note: Google requires 2-Step
# Verification on the Google account before it will let you create
# OAuth credentials at all.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe test-mode secret key, from dashboard.stripe.com -> Developers
# -> API keys. Must start with sk_test_ for local work.
STRIPE_SECRET_KEY=

# Printed by the Stripe CLI when you run:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# It changes every time `stripe listen` restarts, so re-copy it.
# Without a matching value the webhook rejects every event as an
# invalid signature and no ticket is ever issued.
STRIPE_WEBHOOK_SECRET=

# Random 32+ character string. HMAC-SHA256 key used to sign ticket QR
# tokens (src/app/api/webhooks/stripe/route.ts). Changing this
# invalidates every ticket already issued, because check-in matches on
# the stored signature.
TICKET_SIGNING_SECRET=
